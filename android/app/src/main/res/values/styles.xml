<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FolioTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#426149</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F6F3EB</item>
        <item name="android:statusBarColor">#F6F3EB</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F6F3EB</item>
    </style>
    <style name="FolioSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/folio_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/folio_sheet_out</item>
    </style>
</resources>
